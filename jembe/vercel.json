{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.jembegroupllc.com" }],
      "destination": "https://jembegroupllc.com/:path*",
      "permanent": true
    },
    {
      "source": "/preview/jembe",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview/jembe/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/sectors", "destination": "/index.html" },
    { "source": "/sector-energy", "destination": "/index.html" },
    { "source": "/sector-infra", "destination": "/index.html" },
    { "source": "/sector-insurance", "destination": "/index.html" },
    { "source": "/sector-agri", "destination": "/index.html" },
    { "source": "/sector-mining", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/delivery", "destination": "/index.html" },
    { "source": "/network", "destination": "/index.html" },
    { "source": "/track", "destination": "/index.html" },
    { "source": "/offices", "destination": "/index.html" },
    { "source": "/resources", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/mandate", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
