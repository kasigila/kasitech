# Optional — used by `npm run build` in this directory.
# Never put private server secrets in frontend code.

# Public form endpoint (Formspree, Web3Forms, or your own HTTPS API).
# Example Formspree: https://formspree.io/f/xxxxxxxx
# Example Web3Forms: https://api.web3forms.com/submit
JEMBE_FORM_ENDPOINT=

# Web3Forms access key only. Restrict it to jembegroupllc.com in the provider dashboard.
JEMBE_FORM_ACCESS_KEY=

# Mailbox used when no form endpoint is configured (mailto fallback).
JEMBE_MANDATE_EMAIL=info@jembegroup.com

# Canonical origin for this standalone site.
JEMBE_SITE_ORIGIN=https://jembegroupllc.com
