# Used by `npm run build` / Vercel. Never put private SMTP passwords in git.

# Preferred: Formspree form URL or Web3Forms endpoint.
# Example Formspree: https://formspree.io/f/xxxxxxxx
# Example Web3Forms: https://api.web3forms.com/submit
JEMBE_FORM_ENDPOINT=

# Web3Forms access key. Set this on the Vercel project, not in frontend git.
# Restrict the key to jembegroupllc.com in the Web3Forms dashboard.
JEMBE_FORM_ACCESS_KEY=

# Inbox for Formsubmit.co when JEMBE_FORM_ENDPOINT is empty.
JEMBE_MANDATE_EMAIL=info@jembegroup.com

# Canonical origin.
JEMBE_SITE_ORIGIN=https://jembegroupllc.com
